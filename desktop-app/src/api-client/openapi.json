{
 "components": {
  "schemas": {
   "CommandIn": {
    "properties": {
     "command": {
      "anyOf": [
       {
        "enum": [
         "shutdown",
         "restart",
         "logout"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Command"
     },
     "command_obj": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "vd. {\"action\": \"internet_control\", ...}",
      "title": "Command Obj"
     },
     "hostname": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Hostname",
      "type": "string"
     }
    },
    "required": [
     "hostname"
    ],
    "title": "CommandIn",
    "type": "object"
   },
   "GateIn": {
    "properties": {
     "all": {
      "default": false,
      "title": "All",
      "type": "boolean"
     },
     "hosts": {
      "items": {
       "type": "string"
      },
      "maxItems": 2000,
      "title": "Hosts",
      "type": "array"
     },
     "rollout_percent": {
      "default": 0,
      "maximum": 100,
      "minimum": 0,
      "title": "Rollout Percent",
      "type": "integer"
     },
     "rollout_rooms": {
      "items": {
       "type": "string"
      },
      "maxItems": 200,
      "title": "Rollout Rooms",
      "type": "array"
     }
    },
    "title": "GateIn",
    "type": "object"
   },
   "HTTPError": {
    "properties": {
     "detail": {
      "type": "object"
     },
     "message": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "LoginIn": {
    "properties": {
     "password": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Password",
      "type": "string"
     },
     "tenant_code": {
      "description": "Mã tổ chức, vd. PHENIKAA",
      "maxLength": 32,
      "minLength": 2,
      "title": "Tenant Code",
      "type": "string"
     },
     "totp": {
      "anyOf": [
       {
        "maxLength": 10,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Totp"
     },
     "username": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Username",
      "type": "string"
     }
    },
    "required": [
     "tenant_code",
     "username",
     "password"
    ],
    "title": "LoginIn",
    "type": "object"
   },
   "MoveBulkIn": {
    "properties": {
     "device_ids": {
      "items": {
       "type": "string"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Device Ids",
      "type": "array"
     },
     "room_name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Room Name",
      "type": "string"
     }
    },
    "required": [
     "device_ids",
     "room_name"
    ],
    "title": "MoveBulkIn",
    "type": "object"
   },
   "MoveIn": {
    "properties": {
     "room_name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Room Name",
      "type": "string"
     },
     "seat": {
      "default": "",
      "description": "Số vị trí trong phòng (chỉ khi chuyển 1 máy)",
      "maxLength": 4,
      "title": "Seat",
      "type": "string"
     }
    },
    "required": [
     "room_name"
    ],
    "title": "MoveIn",
    "type": "object"
   },
   "PowerShellIn": {
    "properties": {
     "hostnames": {
      "items": {
       "type": "string"
      },
      "maxItems": 2000,
      "minItems": 1,
      "title": "Hostnames",
      "type": "array"
     },
     "password": {
      "default": "",
      "maxLength": 256,
      "title": "Password",
      "type": "string"
     },
     "script": {
      "maxLength": 100000,
      "minLength": 1,
      "title": "Script",
      "type": "string"
     },
     "timeout": {
      "default": 90,
      "maximum": 3600,
      "minimum": 5,
      "title": "Timeout",
      "type": "integer"
     },
     "user": {
      "default": "",
      "description": "Để TRỐNG để chạy quyền SYSTEM (bài học 10.22)",
      "maxLength": 128,
      "title": "User",
      "type": "string"
     }
    },
    "required": [
     "hostnames",
     "script"
    ],
    "title": "PowerShellIn",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "detail": {
      "properties": {
       "<location>": {
        "properties": {
         "<field_name>": {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      },
      "type": "object"
     },
     "message": {
      "type": "string"
     }
    },
    "type": "object"
   }
  }
 },
